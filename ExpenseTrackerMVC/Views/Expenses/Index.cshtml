@model IEnumerable<ExpenseTrackerMVC.Models.Expense>

@{
    ViewData["Title"] = "Expense Management";
}

<style>

    body {
        background: #f4f7fc;
    }

    .expense-header {
        background: linear-gradient(135deg, #0072ff, #6610f2);
        padding: 30px;
        border-radius: 20px;
        color: white;
        margin-bottom: 30px;
        box-shadow: 0px 8px 25px rgba(0,0,0,0.1);
    }

    .expense-title {
        font-size: 42px;
        font-weight: bold;
        margin-bottom: 5px;
    }

    .expense-subtitle {
        font-size: 16px;
        opacity: 0.9;
    }

    .create-btn {
        background: white;
        color: #0072ff;
        padding: 12px 25px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: bold;
        transition: 0.3s;
        box-shadow: 0px 5px 15px rgba(0,0,0,0.1);
    }

        .create-btn:hover {
            background: #f8f9fa;
            transform: translateY(-2px);
            color: #0072ff;
        }

    .table-card {
        background: white;
        padding: 25px;
        border-radius: 20px;
        box-shadow: 0px 5px 20px rgba(0,0,0,0.08);
    }

    .expense-table {
        margin-bottom: 0;
        border-collapse: separate;
        border-spacing: 0 10px;
    }

        .expense-table thead tr {
            background: linear-gradient(90deg, #0d6efd, #6610f2);
        }

        .expense-table th {
            color: white;
            padding: 18px;
            text-align: center;
            border: none;
            font-size: 16px;
        }

        .expense-table tbody tr {
            background: white;
            box-shadow: 0px 3px 10px rgba(0,0,0,0.05);
            transition: 0.3s;
        }

            .expense-table tbody tr:hover {
                transform: scale(1.01);
                background: #f8fbff;
            }

        .expense-table td {
            padding: 18px;
            text-align: center;
            vertical-align: middle;
            border-top: none;
        }

    .amount-badge {
        background: #d1e7dd;
        color: #198754;
        padding: 8px 16px;
        border-radius: 30px;
        font-weight: bold;
        display: inline-block;
    }

    .date-badge {
        background: #e7f1ff;
        color: #0d6efd;
        padding: 8px 16px;
        border-radius: 30px;
        font-weight: 600;
        display: inline-block;
    }

    .action-btn {
        border: none;
        padding: 8px 14px;
        border-radius: 10px;
        color: white;
        font-size: 14px;
        font-weight: 600;
        margin: 2px;
        text-decoration: none;
        transition: 0.3s;
    }

    .details-btn {
        background: #198754;
    }

    .edit-btn {
        background: #0d6efd;
    }

    .delete-btn {
        background: #dc3545;
    }

    .action-btn:hover {
        opacity: 0.9;
        color: white;
        transform: translateY(-1px);
    }

    .empty-message {
        text-align: center;
        padding: 40px;
        color: #6c757d;
        font-size: 18px;
    }

</style>

<div class="container-fluid mt-4">

    <!-- HEADER -->

    <div class="expense-header d-flex justify-content-between align-items-center flex-wrap">

        <div>

            <div class="expense-title">
                💰 Expense Management
            </div>

            <div class="expense-subtitle">
                Manage and monitor all expenses
            </div>

        </div>

       
            <a asp-action="Create"
               class="create-btn">

                + Create Expense

            </a>
        

    </div>

    <!-- TABLE -->

    <div class="table-card">

        <div class="table-responsive">

            <table class="table expense-table align-middle">

                <thead>

                    <tr>

                        <th>
                            📝 Title
                        </th>

                        <th>
                            💵 Amount
                        </th>

                        <th>
                            📄 Description
                        </th>

                        <th>
                            📅 Expense Date
                        </th>

                        <th>
                            ⚙ Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.Title
                                    </strong>
                                </td>

                                <td>

                                    <span class="amount-badge">

                                        ₹ @item.Amount

                                    </span>

                                </td>

                                <td>
                                    @item.Description
                                </td>

                                <td>

                                    <span class="date-badge">

                                        @item.ExpenseDate.ToString("dd MMM yyyy")

                                    </span>

                                </td>

                                <td>

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="action-btn details-btn">

                                        Details

                                    </a>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="action-btn edit-btn">

                                            Edit

                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="action-btn delete-btn">

                                            Delete

                                        </a>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="5">

                                <div class="empty-message">

                                    No Expenses Available

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>