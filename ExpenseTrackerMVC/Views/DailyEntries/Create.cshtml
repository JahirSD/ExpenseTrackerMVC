@model ExpenseTrackerMVC.Models.DailyEntry

@{
    ViewData["Title"] = "Create Daily Entry";
}

<style>

    body {
        background: linear-gradient(135deg, #e0f7fa, #f1f8ff);
        min-height: 100vh;
    }

    .entry-container {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 50px 15px;
    }

    .entry-card {
        width: 100%;
        max-width: 650px;
        background: white;
        border-radius: 25px;
        overflow: hidden;
        box-shadow: 0px 10px 30px rgba(0,0,0,0.15);
    }

    .entry-header {
        background: linear-gradient(90deg, #0072ff, #00c6ff);
        padding: 35px;
        text-align: center;
        color: white;
    }

    .entry-header h1 {
        margin: 0;
        font-size: 40px;
        font-weight: bold;
    }

    .entry-header p {
        margin-top: 10px;
        font-size: 16px;
        opacity: 0.9;
    }

    .entry-body {
        padding: 40px;
    }

    .form-label {
        font-weight: 700;
        color: #343a40;
        margin-bottom: 8px;
    }

    .form-control {
        height: 55px;
        border-radius: 14px;
        border: 1px solid #d6d6d6;
        padding-left: 18px;
        font-size: 16px;
        transition: 0.3s;
    }

    .form-control:focus {
        border-color: #0072ff;
        box-shadow: 0px 0px 10px rgba(0,114,255,0.2);
    }

    select.form-control {
        height: 55px;
    }

    .btn-save {
        width: 100%;
        height: 55px;
        border: none;
        border-radius: 14px;
        background: linear-gradient(90deg, #00c6ff, #0072ff);
        color: white;
        font-size: 20px;
        font-weight: bold;
        margin-top: 10px;
        transition: 0.3s;
    }

    .btn-save:hover {
        transform: translateY(-2px);
        box-shadow: 0px 5px 15px rgba(0,114,255,0.3);
    }

    .back-btn {
        display: inline-block;
        margin-top: 25px;
        text-decoration: none;
        color: #0072ff;
        font-weight: 600;
        transition: 0.3s;
    }

    .back-btn:hover {
        color: #0056b3;
        text-decoration: underline;
    }

    .validation-summary-errors {
        background: #ffe5e5;
        color: #d8000c;
        padding: 10px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

</style>

<div class="entry-container">

    <div class="entry-card">

        <!-- HEADER -->

        <div class="entry-header">

            <h1>
                Daily Entry
            </h1>

            <p>
                Add Employee Expense Details
            </p>

        </div>

        <!-- BODY -->

        <div class="entry-body">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <!-- DATE -->

                <div class="mb-4">

                    <label asp-for="Date"
                           class="form-label">
                    </label>

                    <input asp-for="Date"
                           class="form-control" />

                    <span asp-validation-for="Date"
                          class="text-danger">
                    </span>

                </div>

                <!-- VALUE -->

                <div class="mb-4">

                    <label asp-for="Value"
                           class="form-label">
                        Amount
                    </label>

                    <input asp-for="Value"
                           class="form-control"
                           placeholder="Enter Expense Amount" />

                    <span asp-validation-for="Value"
                          class="text-danger">
                    </span>

                </div>

                <!-- EMPLOYEE -->

                <div class="mb-4">

                    <label asp-for="EmployeeId"
                           class="form-label">
                        Employee Name
                    </label>

                    <select asp-for="EmployeeId"
                            class="form-control"
                            asp-items="ViewBag.EmployeeId">

                        <option value="">
                            -- Select Employee --
                        </option>

                    </select>

                    <span asp-validation-for="EmployeeId"
                          class="text-danger">
                    </span>

                </div>

                <!-- BUTTON -->

                <button type="submit"
                        class="btn-save">

                    Save Daily Entry

                </button>

            </form>

            <!-- BACK -->

            <div class="text-center">

                <a asp-action="Index"
                   class="back-btn">

                    ← Back to List

                </a>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}