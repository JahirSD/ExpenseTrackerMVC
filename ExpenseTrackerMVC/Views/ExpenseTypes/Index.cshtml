@model IEnumerable<ExpenseTrackerMVC.Models.ExpenseType>

@{
    ViewData["Title"] = "Expense Types";
}

<style>

    body {
        background: linear-gradient(to right, #f8fbff, #eef5ff);
        font-family: 'Segoe UI', sans-serif;
    }

    .dashboard-container {
        padding: 30px;
    }

    /* HEADER */

    .top-banner {
        background: linear-gradient(135deg, rgba(37,99,235,0.95), rgba(124,58,237,0.9)), url('https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?q=80&w=1600&auto=format&fit=crop');
        background-size: cover;
        background-position: center;
        border-radius: 28px;
        padding: 40px;
        color: white;
        margin-bottom: 35px;
        box-shadow: 0 12px 35px rgba(0,0,0,0.12);
    }

        .top-banner h1 {
            font-size: 48px;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .top-banner p {
            font-size: 18px;
            opacity: 0.95;
            margin-bottom: 0;
        }

    .add-btn {
        background: white;
        color: #2563eb;
        padding: 14px 26px;
        border-radius: 14px;
        font-weight: 700;
        text-decoration: none;
        transition: 0.3s;
        display: inline-block;
        box-shadow: 0 8px 18px rgba(0,0,0,0.15);
    }

        .add-btn:hover {
            transform: translateY(-2px);
            color: #2563eb;
            background: #f8fafc;
        }

    /* TABLE */

    .table-wrapper {
        background: white;
        border-radius: 24px;
        padding: 25px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.06);
    }

    .custom-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 14px;
    }

        .custom-table thead tr {
            background: linear-gradient(135deg,#2563eb,#7c3aed);
        }

        .custom-table th {
            color: white;
            padding: 18px;
            text-align: center;
            font-size: 15px;
            border: none;
        }

            .custom-table th:first-child {
                border-top-left-radius: 14px;
                border-bottom-left-radius: 14px;
            }

            .custom-table th:last-child {
                border-top-right-radius: 14px;
                border-bottom-right-radius: 14px;
            }

        .custom-table tbody tr {
            background: #fff;
            transition: 0.3s;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

            .custom-table tbody tr:hover {
                transform: translateY(-2px);
                background: #f8fbff;
            }

        .custom-table td {
            padding: 20px;
            text-align: center;
            vertical-align: middle;
            border: none;
        }

            .custom-table td:first-child {
                border-top-left-radius: 14px;
                border-bottom-left-radius: 14px;
            }

            .custom-table td:last-child {
                border-top-right-radius: 14px;
                border-bottom-right-radius: 14px;
            }

    /* BADGE */

    .expense-badge {
        background: #ede9fe;
        color: #7c3aed;
        padding: 10px 20px;
        border-radius: 30px;
        font-weight: 700;
        display: inline-block;
        font-size: 15px;
    }

    /* ACTION BUTTONS */

    .action-btn {
        border: none;
        padding: 9px 16px;
        border-radius: 10px;
        color: white;
        font-size: 14px;
        font-weight: 600;
        margin: 3px;
        text-decoration: none;
        transition: 0.3s;
        display: inline-block;
    }

    .edit-btn {
        background: #2563eb;
    }

    .details-btn {
        background: #16a34a;
    }

    .delete-btn {
        background: #dc2626;
    }

    .action-btn:hover {
        opacity: 0.9;
        transform: translateY(-1px);
        color: white;
    }

    /* EMPTY */

    .empty-box {
        padding: 60px;
        text-align: center;
        color: #64748b;
    }

        .empty-box h4 {
            font-size: 28px;
            margin-top: 15px;
        }

</style>

<div class="container-fluid dashboard-container">

    <!-- HEADER -->

    <div class="top-banner d-flex justify-content-between align-items-center flex-wrap">

        <div>

            <h1>
                🧾 Expense Types
            </h1>

            <p>
                Manage categories for employee and company expenses
            </p>

        </div>

        <div class="mt-3 mt-md-0">

            <a asp-action="Create"
               class="add-btn">

                + Add Expense Type

            </a>

        </div>

    </div>

    <!-- TABLE -->

    <div class="table-wrapper">

        <div class="table-responsive">

            <table class="table custom-table">

                <thead>

                    <tr>

                        <th>
                            🏷 Expense Type Name
                        </th>

                        <th width="320">
                            ⚙ Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>

                                    <span class="expense-badge">

                                        @item.Name

                                    </span>

                                </td>

                                <td>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="action-btn edit-btn">

                                        Edit

                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="action-btn details-btn">

                                        Details

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="action-btn delete-btn">

                                        Delete

                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="2">

                                <div class="empty-box">

                                    <h4>
                                        No Expense Types Found
                                    </h4>

                                    <p>
                                        Start by creating your first expense category.
                                    </p>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>