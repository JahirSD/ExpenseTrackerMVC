@{
    ViewData["Title"] = "Privacy Policy";
}

<style>

    body {
        background-color: #f4f7fc;
    }

    .privacy-container {
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0px 5px 20px rgba(0,0,0,0.08);
        margin-top: 30px;
        margin-bottom: 30px;
    }

    .page-title {
        text-align: center;
        font-size: 38px;
        font-weight: bold;
        color: #0d6efd;
        margin-bottom: 10px;
    }

    .page-subtitle {
        text-align: center;
        color: #6c757d;
        margin-bottom: 35px;
        font-size: 15px;
    }

    .section-title {
        color: #0d6efd;
        font-size: 24px;
        font-weight: 600;
        margin-top: 25px;
        margin-bottom: 15px;
    }

    .section-text {
        color: #495057;
        font-size: 15px;
        line-height: 1.8;
    }

    .info-box {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 15px;
        margin-top: 15px;
    }

    .contact-item {
        margin-bottom: 10px;
        font-size: 15px;
    }

    @@media(max-width:768px) {

        .privacy-container {
            padding: 20px;
        }

        .page-title {
            font-size: 28px;
        }

        .section-title {
            font-size: 20px;
        }
    }

</style>

<div class="container">

    <div class="privacy-container">

        <!-- TITLE -->

        <div class="page-title">

            Privacy Policy

        </div>

        <div class="page-subtitle">

            Your privacy and data security are important to us

        </div>

        <!-- PRIVACY POLICY -->

        <div class="section-title">

            🔒 Privacy Policy

        </div>

        <div class="section-text">

            Expense Tracker Management System is committed to protecting
            your personal information and maintaining data privacy.

            We collect only the necessary information required for
            employee expense management, reporting, and application
            functionality.

            Your data will never be shared with third parties without
            your permission.

        </div>

        <!-- DATA SECURITY -->

        <div class="section-title">

            🛡 Data Security

        </div>

        <div class="section-text">

            Our system uses secure authentication, role-based access,
            and database protection to ensure your information remains safe.

            Only authorized users can access employee and expense data.

        </div>

        <!-- ABOUT US -->

        <div class="section-title">

            ℹ About Us

        </div>

        <div class="section-text">

            JK Software Solutions develops modern web applications using
            ASP.NET Core MVC, Entity Framework Core, and SQL Server.

            Our goal is to create simple, secure, and professional
            business management applications for organizations.

        </div>

        <!-- CONTACT -->

        <div class="section-title">

            📞 Contact Information

        </div>

        <div class="info-box">

            <div class="contact-item">

                📧 Email:
                jksoftwaresolutions@gmail.com

            </div>

            <div class="contact-item">

                📱 Phone:
                +91 75025 87362

            </div>

            <div class="contact-item">

                🌐 Website:
                www.jksoftwaresolutions.com

            </div>

            <div class="contact-item">

                📍 Location:
                Chennai, Tamil Nadu, India

            </div>

        </div>

    </div>

</div>