@{
    ViewData["Title"] = "Home Page";
}

<style>

    body {
        background-color: #f4f7fc;
    }

    /* HERO SECTION */

    .hero-section {
        background: linear-gradient(rgba(0, 80, 180, 0.55), rgba(0, 120, 255, 0.45)), url('/images/expense-bg.jpg');
        background-size: cover;
        background-position: center;
        border-radius: 20px;
        min-height: 500px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: white;
        padding: 40px;
        box-shadow: 0px 8px 25px rgba(0,0,0,0.15);
    }

    .hero-content h1 {
        font-size: 60px;
        font-weight: bold;
        margin-bottom: 20px;
    }

    .hero-content p {
        font-size: 22px;
        margin-bottom: 30px;
        color: #f1f1f1;
    }

    .hero-btn {
        background: linear-gradient(90deg, #00c6ff, #0072ff);
        color: white;
        padding: 14px 35px;
        border-radius: 12px;
        text-decoration: none;
        font-size: 18px;
        font-weight: bold;
        transition: 0.3s;
        display: inline-block;
    }

        .hero-btn:hover {
            transform: translateY(-2px);
            color: white;
            opacity: 0.95;
        }

    /* FEATURES */

    .features-section {
        margin-top: 50px;
    }

    .feature-card {
        background: white;
        padding: 30px;
        border-radius: 18px;
        text-align: center;
        box-shadow: 0px 4px 15px rgba(0,0,0,0.08);
        transition: 0.3s;
        height: 100%;
    }

        .feature-card:hover {
            transform: translateY(-5px);
        }

    .feature-icon {
        font-size: 50px;
        margin-bottom: 20px;
    }

    .feature-title {
        font-size: 24px;
        font-weight: bold;
        margin-bottom: 10px;
        color: #0d6efd;
    }

    .feature-text {
        color: #6c757d;
        font-size: 15px;
    }

    /* FOOTER BANNER */

    .bottom-banner {
        margin-top: 60px;
        background: linear-gradient(90deg, #0d6efd, #6610f2);
        color: white;
        padding: 35px;
        border-radius: 20px;
        text-align: center;
    }

        .bottom-banner h2 {
            font-weight: bold;
            margin-bottom: 10px;
        }

        .bottom-banner p {
            margin-bottom: 0;
            font-size: 18px;
        }

    /* MOBILE */

    @@media(max-width:768px) {

        .hero-content h1 {
            font-size: 38px;
        }

        .hero-content p {
            font-size: 18px;
        }

        .hero-section {
            min-height: 400px;
        }
    }

</style>

<!-- HERO SECTION -->

<div class="hero-section">

    <div class="hero-content">

        <h1>
            Expense Tracker System
        </h1>

        <p>
            Manage Daily Expenses, Employee Reports,
            Monthly Reports and Business Expenses Easily
        </p>

        <a asp-controller="Expenses"
           asp-action="Index"
           class="hero-btn">

            Get Started

        </a>

    </div>

</div>

<!-- FEATURES -->

<div class="features-section">

    <div class="row g-4">

        <div class="col-md-4">

            <div class="feature-card">

                <div class="feature-icon">
                    💰
                </div>

                <div class="feature-title">
                    Expense Management
                </div>

                <div class="feature-text">

                    Track and manage all company expenses
                    with simple and powerful tools.

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="feature-card">

                <div class="feature-icon">
                    👨‍💼
                </div>

                <div class="feature-title">
                    Employee Tracking
                </div>

                <div class="feature-text">

                    Monitor employee daily entries,
                    transportation and expense reports.

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="feature-card">

                <div class="feature-icon">
                    📊
                </div>

                <div class="feature-title">
                    Monthly Reports
                </div>

                <div class="feature-text">

                    Generate monthly reports with automatic
                    calculations and summaries.

                </div>

            </div>

        </div>

    </div>

</div>

<!-- FOOTER BANNER -->

<div class="bottom-banner">

    <h2>
        JK Software Solutions
    </h2>

    <p>
        ASP.NET Core MVC | Entity Framework Core | SQL Server
    </p>

</div>